# ============================================
# Python кэш и байт-код
# ============================================
__pycache__/
*.py[cod]
*$py.class

# ============================================
# Spyder IDE
# ============================================
.spyproject/
.spyder/
.spytemp/
*.spydata

# ============================================
# Конкретные папки (замените на свои названия)
# ============================================
_INPUT_DATA/
_OUTPUT_DATA/
_REFERENCE_DATA/

# ============================================
# Виртуальное окружение
# ============================================
venv/
env/
.venv/

# ============================================
# Другие общие исключения для Python
# ============================================
*.egg-info/
dist/
build/
*.egg
*.log
*.xlsx
*.json
*.md
!README.md
!AGENTS.md
!TASKS.md

# ============================================
# Временные рабочие файлы (начинаются с _)
# Папки _INPUT_DATA / _OUTPUT_DATA / _REFERENCE_DATA
# исключены выше явно
# ============================================
_*

# Смоук-тесты — служебный код, который должен попадать в репозиторий
!_smoke_*.py

# Миксины шагов (pipeline/steps/_step14_base.py, _corrections_base.py и т.п.) —
# часть конвейера, несмотря на подчёркивание в имени. Без этой строки
# `git add .` молча пропустил бы новый миксин: правило `_*` выше перекрывает их,
# и конвейер уехал бы в репозиторий без обязательной части.
!pipeline/steps/_*.py

# Файлы среды
.env
.env.local

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# OS файлы
.DS_Store
Thumbs.db